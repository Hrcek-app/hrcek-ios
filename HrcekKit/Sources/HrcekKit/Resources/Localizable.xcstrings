    },
    "Something went wrong. Try again." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekaj je šlo narobe. Poskusite znova."
          }
        }
      }
    },
    "That doesn't look like a web address." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ni videti kot spletni naslov."
          }
        }
