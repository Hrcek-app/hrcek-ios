      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naslov se mora začeti s https://."
          }
        }
      }
    },
    "The server is having trouble. Try again later." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik ima težave. Poskusite znova pozneje."
          }
        }
      }
    },
    "The server took too long to answer. Try again." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik se ni odzval dovolj hitro. Poskusite znova."
          }
        }
      }
    },
    "The server's answer wasn't understood. Is this a Hrček address?" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
