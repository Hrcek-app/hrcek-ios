    "Hrček" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrček"
          }
        }
      }
    },
    "Hrček can't be reached. Saving keeps this entry on this phone until it can." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrčka ni mogoče doseči. Ob shranjevanju vnos ostane na tem telefonu, dokler ga ne bo mogoče doseči."
          }
        }
      }
    },
    "Hrček no longer accepts this phone's sign-in. Open the Hrček app and sign in again." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrček ne sprejema več prijave s tega telefona. Odprite aplikacijo Hrček in se znova prijavite."
          }
        }
      }
    },
    "Include picture" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vključi sliko"
          }
        }
      }
    },
    "It has a picture that cannot be shown here" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ima sliko, ki je tu ni mogoče pokazati"
          }
        }
      }
    },
    "It will be saved to Hrček once it can be reached." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Hrček bo shranjeno, ko bo dosegljiv."
