      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odjava"
          }
        }
      }
    },
    "Sign out?" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se želite odjaviti?"
          }
        }
      }
    },
    "Signed in as %@ on %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Signed in as %1$@ on %2$@"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavljeni ste kot %1$@ na %2$@"
