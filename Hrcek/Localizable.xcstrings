      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za sinhronizacijo se prijavite."
          }
        }
      }
    },
    "Sign in with" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijava z"
          }
        }
      }
    },
