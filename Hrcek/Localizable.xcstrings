      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-žeton"
          }
        }
      }
    },
    "Also the language of the Share sheet and of the server's messages." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudi jezik menija Deli in sporočil strežnika."
          }
        }
      }
    },
    "Choose Hrček. If it isn't in the row, tap More and add it." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite Hrček. Če ga ni v vrstici, tapnite Več in ga dodajte."
          }
        }
      }
    },
    "Delete" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbriši"
          }
        }
      }
    },
    "Delete this page?" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrišem to stran?"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Končano"
          }
        }
      }
    },
    "Email or display name" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-pošta ali prikazno ime"
          }
        }
      }
    },
    "How to save a page" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako shranite stran"
          }
        }
      }
    },
    "Hrček" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrček"
          }
        }
      }
    },
    "Hrček already has this page." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrček to stran že ima."
          }
        }
      }
    },
    "It has not been saved to Hrček, and will be gone from this phone." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Hrček še ni shranjena in bo izginila s tega telefona."
          }
        }
      }
    },
    "Language" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jezik"
          }
        }
      }
    },
    "Make one on the website, on your account's clients page, and paste it here." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naredite ga na spletni strani, na strani odjemalcev svojega računa, in ga prilepite sem."
          }
        }
      }
    },
    "Manage this phone's access on the website" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostop tega telefona upravljajte na spletni strani"
          }
        }
      }
    },
    "Nothing is waiting." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nič ne čaka."
          }
        }
      }
    },
    "Open the page in Safari or another browser." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stran odprite v Safariju ali drugem brskalniku."
          }
        }
      }
    },
