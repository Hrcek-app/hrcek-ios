      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geslo"
          }
        }
      }
    },
    "Saved for %@, which is not the server you're signed in to." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shranjeno za %@, ki ni strežnik, v katerega ste prijavljeni."
          }
        }
      }
    },
