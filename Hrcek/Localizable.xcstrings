    },
    "Sync now" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinhroniziraj zdaj"
          }
        }
      }
    },
    "Tap the Share button." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapnite gumb Deli."
          }
        }
      }
    },
    "The address you open Hrček at in your browser." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naslov, na katerem Hrček odprete v brskalniku."
          }
        }
      }
    },
    "This phone forgets your sign-in. Its access token keeps working until you remove it on the website's clients page." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon pozabi vašo prijavo. Njegov žeton za dostop deluje, dokler ga ne odstranite na strani odjemalcev na spletni strani."
          }
        }
      }
    },
    "Waiting to sync" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čaka na sinhronizacijo"
          }
        }
      }
    },
    "Your password is used once to make a token for this phone, and never kept." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geslo se uporabi enkrat, da se za ta telefon naredi žeton, in se nikoli ne shrani."
          }
        }
      }
    }
