#!/usr/bin/env bash
# Prints an xcodebuild destination: $HRCEK_SIMULATOR by name, or the newest iPhone.
# With --boot, boots that simulator first and waits until it is ready.
set -euo pipefail
udid=$(xcrun simctl list devices available --json | jq -r --arg name "${HRCEK_SIMULATOR:-}" '
  [.devices | to_entries[] | select(.key | test("iOS")) | .key as $runtime
   | .value[] | select(if $name == "" then .name | startswith("iPhone") else .name == $name end)
   | {runtime: $runtime, udid}]
  | sort_by(.runtime) | last | .udid // empty')
if [[ -z "$udid" ]]; then
  echo "No simulator named ${HRCEK_SIMULATOR:-iPhone…} found." \
    "Install one in Xcode > Settings > Components." >&2
  exit 1
fi
if [[ "${1:-}" == --boot ]]; then
  # A cold boot inside xcodebuild can outlast its launch timeout.
  xcrun simctl bootstatus "$udid" -b >&2
fi
echo "platform=iOS Simulator,id=$udid"
