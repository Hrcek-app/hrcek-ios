#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# ///
"""Stands in front of a real Hrček for scripts/e2e, and plays an outage
on request: POST /proxy/outage makes it answer 503 to everything, as a
reverse proxy does for a stopped Hrček; POST /proxy/restore passes
requests through again."""

import argparse
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PASSED = ("Authorization", "Content-Type", "Accept", "Accept-Language")


class Proxy(BaseHTTPRequestHandler):
    upstream = ""
    down = False

    def log_message(self, format, *args):  # noqa: A002 - keeps output quiet
        pass

    def answer(self, status, body, kind="text/plain"):
        self.send_response(status)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def relay(self):
        if self.path in ("/proxy/outage", "/proxy/restore"):
            Proxy.down = self.path == "/proxy/outage"
            return self.answer(200, b"ok")
        if Proxy.down:
            return self.answer(503, b"<html>Service Unavailable</html>", "text/html")
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length) if length else None
        request = urllib.request.Request(
            Proxy.upstream + self.path, data=body, method=self.command,
            headers={k: v for k in PASSED if (v := self.headers.get(k))})
        try:
            with urllib.request.urlopen(request) as response:
                status, kind, data = response.status, response.headers.get("Content-Type"), response.read()
        except urllib.error.HTTPError as error:
            status, kind, data = error.code, error.headers.get("Content-Type"), error.read()
        self.answer(status, data, kind or "application/octet-stream")

    do_GET = do_POST = do_DELETE = relay


parser = argparse.ArgumentParser()
parser.add_argument("--port", type=int, required=True)
parser.add_argument("--upstream", required=True)
arguments = parser.parse_args()
Proxy.upstream = arguments.upstream.rstrip("/")
ThreadingHTTPServer(("127.0.0.1", arguments.port), Proxy).serve_forever()
